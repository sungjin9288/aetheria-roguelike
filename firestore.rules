rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Aetheria RPG — Firestore 보안 규칙
    // APP_ID: aetheria-rpg  (v5.0 출시용)
    // 마지막 수정: 2026-03-25
    // ============================================================

    // 인증 유저 여부 공통 함수
    function isAuthed() {
      return request.auth != null;
    }

    // 본인 UID 일치 여부
    function isSelf(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    // 문자열 길이 범위 검사
    function strLen(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // 앱 ID를 리터럴로 고정 — 와일드카드 대신 'aetheria-rpg' 전용
    match /artifacts/aetheria-rpg {

      // ── 유저 개인 저장 데이터 ──────────────────────────────────
      // 경로: artifacts/aetheria-rpg/users/{uid}
      match /users/{uid} {
        // 본인만 읽기
        allow read: if isSelf(uid);

        // 본인만 쓰기 + 기본 구조 검증
        // payload: { player, gameState, enemy, grave, currentEvent, quickSlots,
        //            onboardingDismissed, version, lastActive }
        allow write: if isSelf(uid)
          && request.resource.data.keys().hasAll(['player', 'gameState', 'lastActive'])
          && request.resource.data.lastActive is timestamp;

        // 기록 히스토리 서브컬렉션: 본인만
        match /history/{docId} {
          allow read, write: if isSelf(uid);
        }
      }

      // ── AI token quota (client write-only, per-user) ─────────────
      // 경로: artifacts/aetheria-rpg/users/{uid}/quota/daily-ai
      // 클라이언트는 자신의 quota snapshot만 생성/갱신할 수 있고, 읽기/삭제는 불가.
      //
      // W13-E4 — 정산 내역(`adopted`/`unadopted`)을 함께 받는다. 설계 결정 4개:
      //   1. `hasAll`은 4키 그대로다. 이미 설치된 구버전 클라이언트(Capacitor 앱)는
      //      정산 키를 모르고 영원히 4키만 쓴다 — 필수로 만들면 그 설치본의 쿼터 쓰기가
      //      전부 거부되고, 클라이언트의 `catch`가 `console.warn`이라 조용히 죽는다.
      //      넓히는 것은 `hasOnly`뿐이므로 **신규 rules는 구버전 클라이언트와 호환**이고
      //      **구버전 rules는 신규 클라이언트와 비호환**이다 → 배포 순서는 rules 먼저다
      //      (같은 커밋이어도 배포는 두 파이프라인이다: deploy.yml은 hosting만 올린다).
      //      알려진 경계: `merge: true`라 `request.resource.data`는 **병합 후** 문서다.
      //      그래서 같은 날짜의 구버전 4키 쓰기는 정산 키를 보존해 그대로 통과하지만,
      //      **날짜가 바뀐 직후**의 구버전 쓰기는 어제 정산이 남아 있어 거부된다 —
      //      신버전이 한 번 동기화하면 즉시 풀리는 자기치유 구간이고(부트마다 동기화),
      //      기존 단조성(디바이스 간 max-wins)이 이미 만드는 거부와 같은 종류다.
      //   2. `unsettled`는 싣지 않는다. 정산이 기록될수록 **감소**하므로 `used`와 같은
      //      단조 규칙을 걸 수 없다(걸면 정상 쓰기가 거부되고, 안 걸면 롤백이 통과한다).
      //      대신 `adopted + unadopted <= used`를 강제해 소비자가
      //      `unsettled = used - adopted - unadopted >= 0`으로 도출한다.
      //   3. 새 카운터에 리터럴 상한을 **추가하지 않는다**. `used`에 상대적으로 묶이므로
      //      `BALANCE.DAILY_AI_LIMIT` 리터럴 커플링 표면이 넓어지지 않는다(50은 여전히 2곳).
      //   4. 모양 검증은 `quotaShapeOk()` 한 곳이다 — create/update가 각자 복제하면
      //      드리프트가 생기고, 그 드리프트를 검증할 방법이 이 저장소에는 없다.
      match /users/{uid}/quota/daily-ai {
        // 정산 카운터는 **선택 필드**다 — 없으면 0으로 읽는다(구버전 클라이언트 호환).
        function tally(data, key) {
          return data.get(key, 0);
        }

        // 페이로드 모양 — create/update 공용(복제 금지).
        function quotaShapeOk(data) {
          return data.keys().hasAll(['date', 'used', 'limit', 'updatedAt'])
            && data.keys().hasOnly(['date', 'used', 'adopted', 'unadopted', 'limit', 'updatedAt'])
            && data.date is string
            && data.used is int
            && data.used >= 0
            && data.used <= 50
            && data.limit == 50
            && tally(data, 'adopted') is int
            && tally(data, 'adopted') >= 0
            && tally(data, 'unadopted') is int
            && tally(data, 'unadopted') >= 0
            && tally(data, 'adopted') + tally(data, 'unadopted') <= data.used;
        }

        allow read: if false;
        allow delete: if false;

        allow create: if isSelf(uid)
          && quotaShapeOk(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        // 단조성: 같은 날짜면 세 카운터 전부 감소 불가, 날짜가 바뀌면 전부 0으로 리셋.
        // `used`에만 걸고 정산을 빼면 롤백 쓰기 한 번으로 정산이 되감긴다.
        allow update: if isSelf(uid)
          && quotaShapeOk(request.resource.data)
          && request.resource.data.updatedAt == request.time
          && (request.resource.data.date == resource.data.date
              ? (request.resource.data.used >= resource.data.used
                 && tally(request.resource.data, 'adopted') >= tally(resource.data, 'adopted')
                 && tally(request.resource.data, 'unadopted') >= tally(resource.data, 'unadopted'))
              : (request.resource.data.used == 0
                 && tally(request.resource.data, 'adopted') == 0
                 && tally(request.resource.data, 'unadopted') == 0));
      }

      // ── 공개 설정 (live config) ────────────────────────────────
      // 경로: artifacts/aetheria-rpg/public/data
      // 읽기: 모두 허용 (앱 초기화에 필요)
      // 쓰기: 완전 차단 (Firebase Console에서만 관리)
      match /public/data {
        allow read: if true;
        allow write: if false;
      }

      // ── 리더보드 ──────────────────────────────────────────────
      // 경로: artifacts/aetheria-rpg/public/data/leaderboard/{uid}
      match /public/data/leaderboard/{uid} {
        // 누구나 읽기 (랭킹 조회)
        allow read: if true;

        // 본인 entry만 쓰기 + 필드 유효성 검사
        allow write: if isSelf(uid)
          && request.resource.data.keys().hasAll(['nickname', 'totalKills', 'uid', 'updatedAt'])
          && request.resource.data.uid == uid
          && strLen(request.resource.data.nickname, 20)
          && request.resource.data.totalKills is number
          && request.resource.data.totalKills >= 0
          && request.resource.data.totalKills <= 100000  // 비정상적 수치 차단
          && request.resource.data.updatedAt is timestamp;
      }

      // ── 공개 묘비 (PvP) ───────────────────────────────────────
      // 경로: artifacts/aetheria-rpg/public/data/graves/{uid}
      match /public/data/graves/{uid} {
        // 인증된 유저만 읽기 (미인증 차단)
        allow read: if isAuthed();

        // 본인 묘비만 생성/갱신
        allow write: if isSelf(uid)
          && request.resource.data.uid == uid
          // 필수 필드 존재 확인
          && request.resource.data.keys().hasAll([
               'playerName', 'level', 'loc', 'gold',
               'guardPower', 'createdAt', 'uid'
             ])
          // playerName: 1~20자 문자열
          && strLen(request.resource.data.playerName, 20)
          // level: 1~99
          && request.resource.data.level is number
          && request.resource.data.level >= 1
          && request.resource.data.level <= 99
          // loc: 1~30자 문자열
          && strLen(request.resource.data.loc, 30)
          // gold: 0~9,999,999
          && request.resource.data.gold is number
          && request.resource.data.gold >= 0
          && request.resource.data.gold <= 9999999
          // guardPower: 0~9999
          && request.resource.data.guardPower is number
          && request.resource.data.guardPower >= 0
          && request.resource.data.guardPower <= 9999
          // createdAt: 서버 타임스탬프
          && request.resource.data.createdAt is timestamp
          // items 필드가 있는 경우 배열이고 최대 5개
          && (!('items' in request.resource.data)
              || (request.resource.data.items is list
                  && request.resource.data.items.size() <= 5));

        // 삭제: 클라이언트에서 불가 (서버/Admin SDK 전용)
        allow delete: if false;
      }

      // ── 그 외 하위 경로: 전면 차단 ────────────────────────────
      match /{document=**} {
        allow read, write: if false;
      }
    }

    // aetheria-rpg 외 다른 appId 전면 차단
    match /artifacts/{appId}/{document=**} {
      allow read, write: if false;
    }

    // 최상위 다른 컬렉션 전면 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
